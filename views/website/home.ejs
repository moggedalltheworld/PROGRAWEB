<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Resident Evil | Survival Horror</title>

    <!-- Bootstrap 5 -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link 
        rel="stylesheet" 
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link 
        href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@300;400;500;600;700&display=swap" 
        rel="stylesheet"
    >

    <style>

        /* =========================
           GENERAL
        ========================= */

        body {
            margin: 0;
            background: #080808;
            color: #fff;
            font-family: 'Montserrat', sans-serif;
        }

        h1, h2, h3, .navbar-brand {
            font-family: 'Bebas Neue', sans-serif;
            letter-spacing: 2px;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            background: rgba(0, 0, 0, 0.92);
            border-bottom: 1px solid #292929;
            padding: 15px 0;
        }

        .navbar-brand {
            color: #b30000 !important;
            font-size: 2rem;
        }

        .navbar-brand span {
            color: white;
        }

        .nav-link {
            color: #ccc !important;
            margin-left: 20px;
            transition: 0.3s;
        }

        .nav-link:hover {
            color: #c40000 !important;
        }

        .btn-danger {
            background: #a50000;
            border: none;
        }

        .btn-danger:hover {
            background: #d00000;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 90vh;

            background:
                linear-gradient(
                    to right,
                    rgba(0,0,0,0.95) 0%,
                    rgba(0,0,0,0.70) 45%,
                    rgba(0,0,0,0.25) 100%
                ),
                url("https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=2000&q=80");

            background-size: cover;
            background-position: center;

            display: flex;
            align-items: center;
        }

        .hero-content {
            max-width: 650px;
        }

        .hero h1 {
            font-size: clamp(4rem, 9vw, 8rem);
            line-height: 0.85;
            margin-bottom: 25px;
        }

        .hero h1 span {
            color: #a90000;
        }

        .hero p {
            color: #d0d0d0;
            font-size: 1.1rem;
            line-height: 1.8;
        }

        .hero-buttons {
            margin-top: 30px;
        }

        .btn-outline-light {
            border-radius: 0;
        }

        .btn-danger {
            border-radius: 0;
            padding: 12px 28px;
        }

        /* =========================
           SECTION
        ========================= */

        .section-title {
            font-size: 3.5rem;
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title span {
            color: #a90000;
        }

        .games-section {
            padding: 90px 0;
            background: #0c0c0c;
        }

        /* =========================
           CARDS
        ========================= */

        .game-card {
            background: #151515;
            border: 1px solid #292929;
            border-radius: 0;
            overflow: hidden;
            transition: 0.4s;
            height: 100%;
        }

        .game-card:hover {
            transform: translateY(-10px);
            border-color: #a90000;
            box-shadow: 0 10px 35px rgba(170, 0, 0, 0.25);
        }

        .game-card img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            transition: 0.4s;
        }

        .game-card:hover img {
            transform: scale(1.05);
        }

        .card-body {
            padding: 25px;
        }

        .card-title {
            font-size: 2rem;
        }

        .card-text {
            color: #aaa;
            line-height: 1.7;
        }

        /* =========================
           ABOUT
        ========================= */

        .about-section {
            padding: 100px 0;
            background: #050505;
        }

        .about-box {
            border-left: 4px solid #a90000;
            padding-left: 30px;
        }

        .about-box p {
            color: #aaa;
            line-height: 1.9;
        }

        .stat {
            text-align: center;
            padding: 25px;
            background: #111;
            border: 1px solid #252525;
        }

        .stat h3 {
            color: #b00000;
            font-size: 3rem;
        }

        .stat p {
            color: #aaa;
            margin: 0;
        }

        /* =========================
           CHARACTERS
        ========================= */

        .characters-section {
            padding: 90px 0;
            background: #0b0b0b;
        }

        .character {
            position: relative;
            overflow: hidden;
            height: 400px;
            background: #111;
        }

        .character img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

        .character:hover img {
            transform: scale(1.08);
        }

        .character-info {
            position: absolute;
            bottom: 0;
            width: 100%;
            padding: 30px 20px 20px;

            background: linear-gradient(
                transparent,
                rgba(0,0,0,0.95)
            );
        }

        .character-info h3 {
            font-size: 2.2rem;
            margin: 0;
        }

        .character-info p {
            color: #aaa;
            margin: 0;
        }

        /* =========================
           CTA
        ========================= */

        .cta {
            padding: 100px 20px;
            text-align: center;

            background:
                linear-gradient(
                    rgba(0,0,0,0.75),
                    rgba(0,0,0,0.95)
                ),
                url("https://images.unsplash.com/photo-1531058020387-3be344556be6?auto=format&fit=crop&w=1800&q=80");

            background-size: cover;
            background-position: center;
        }

        .cta h2 {
            font-size: 4rem;
        }

        .cta p {
            color: #bbb;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: #030303;
            border-top: 1px solid #222;
            padding: 30px 0;
            color: #777;
            text-align: center;
        }

        footer span {
            color: #a90000;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 768px) {

            .navbar-brand {
                font-size: 1.7rem;
            }

            .hero {
                min-height: 85vh;
                background-position: 65% center;
            }

            .hero h1 {
                font-size: 5rem;
            }

            .section-title {
                font-size: 2.8rem;
            }

            .cta h2 {
                font-size: 3rem;
            }
        }

    </style>
</head>

<body>

    <!-- =========================
         NAVBAR
    ========================= -->

    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">

        <div class="container">

            <a class="navbar-brand" href="#">
                RESIDENT <span>EVIL</span>
            </a>

            <button 
                class="navbar-toggler" 
                type="button" 
                data-bs-toggle="collapse" 
                data-bs-target="#navbarNav"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="#home">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#games">Games</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#characters">Characters</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>

                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a href="#games" class="btn btn-danger">
                            EXPLORE
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>


    <!-- =========================
         HERO
    ========================= -->

    <section class="hero" id="home">

        <div class="container">

            <div class="hero-content">

                <p class="text-danger fw-bold">
                    WELCOME TO RACCOON CITY
                </p>

                <h1>
                    RESIDENT <span>EVIL</span>
                </h1>

                <p>
                    Enter a world where survival is the only option.
                    Explore the iconic universe of Resident Evil,
                    face terrifying creatures and discover the stories
                    behind one of gaming's greatest survival horror sagas.
                </p>

                <div class="hero-buttons">

                    <a href="#games" class="btn btn-danger me-2">
                        <i class="bi bi-controller"></i>
                        EXPLORE GAMES
                    </a>

                    <a href="#characters" class="btn btn-outline-light">
                        CHARACTERS
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         GAMES
    ========================= -->

    <section class="games-section" id="games">

        <div class="container">

            <h2 class="section-title">
                ICONIC <span>GAMES</span>
            </h2>

            <div class="row g-4">

                <!-- RE2 -->

                <div class="col-md-4">

                    <div class="card game-card">

                        <img 
                            src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=900&q=80"
                            alt="Resident Evil"
                        >

                        <div class="card-body">

                            <h3 class="card-title">
                                RESIDENT EVIL 2
                            </h3>

                            <p class="card-text">
                                Return to Raccoon City and experience
                                the nightmare through the eyes of Leon
                                Kennedy and Claire Redfield.
                            </p>

                            <a href="#" class="btn btn-outline-danger">
                                DISCOVER
                            </a>

                        </div>

                    </div>

                </div>


                <!-- RE4 -->

                <div class="col-md-4">

                    <div class="card game-card">

                        <img 
                            src="https://images.unsplash.com/photo-1560253023-3ec5d502959f?auto=format&fit=crop&w=900&q=80"
                            alt="Horror game"
                        >

                        <div class="card-body">

                            <h3 class="card-title">
                                RESIDENT EVIL 4
                            </h3>

                            <p class="card-text">
                                Leon S. Kennedy embarks on a dangerous
                                mission to rescue the president's daughter
                                from a mysterious cult.
                            </p>

                            <a href="#" class="btn btn-outline-danger">
                                DISCOVER
                            </a>

                        </div>

                    </div>

                </div>


                <!-- RE7 -->

                <div class="col-md-4">

                    <div class="card game-card">

                        <img 
                            src="https://images.unsplash.com/photo-1509248961158-e54f6934749c?auto=format&fit=crop&w=900&q=80"
                            alt="Dark horror environment"
                        >

                        <div class="card-body">

                            <h3 class="card-title">
                                RESIDENT EVIL 7
                            </h3>

                            <p class="card-text">
                                Discover the terrifying Baker family
                                and survive a nightmare unlike anything
                                you have experienced before.
                            </p>

                            <a href="#" class="btn btn-outline-danger">
                                DISCOVER
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         ABOUT
    ========================= -->

    <section class="about-section" id="about">

        <div class="container">

            <div class="row align-items-center g-5">

                <div class="col-lg-7">

                    <div class="about-box">

                        <p class="text-danger fw-bold">
                            SURVIVAL HORROR
                        </p>

                        <h2 class="display-3">
                            FEAR HAS A NEW <span class="text-danger">
                            NAME
                            </span>
                        </h2>

                        <p>
                            Resident Evil is one of the most influential
                            survival horror franchises in video game history.
                            From the Spencer Mansion to Raccoon City and
                            beyond, its universe combines horror, action,
                            mystery and biological experimentation.
                        </p>

                        <p>
                            Manage your resources, solve puzzles and survive
                            against enemies that are always waiting around
                            the next corner.
                        </p>

                    </div>

                </div>


                <div class="col-lg-5">

                    <div class="row g-3">

                        <div class="col-6">
                            <div class="stat">
                                <h3>1996</h3>
                                <p>FIRST GAME</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat">
                                <h3>30+</h3>
                                <p>YEARS OF HORROR</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat">
                                <h3>∞</h3>
                                <p>NIGHTMARES</p>
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="stat">
                                <h3>R.P.D.</h3>
                                <p>RACCOON CITY</p>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         CHARACTERS
    ========================= -->

    <section class="characters-section" id="characters">

        <div class="container">

            <h2 class="section-title">
                SURVIVORS & <span>LEGENDS</span>
            </h2>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="character">

                        <img 
                            src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=700&q=80"
                            alt="Character"
                        >

                        <div class="character-info">

                            <h3>CLAIRE REDFIELD</h3>

                            <p>
                                Survivor · Activist · Fighter
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="character">

                        <img 
                            src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=700&q=80"
                            alt="Character"
                        >

                        <div class="character-info">

                            <h3>LEON KENNEDY</h3>

                            <p>
                                Agent · Survivor · Specialist
                            </p>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="character">

                        <img 
                            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=700&q=80"
                            alt="Character"
                        >

                        <div class="character-info">

                            <h3>JILL VALENTINE</h3>

                            <p>
                                S.T.A.R.S. · Survivor · Veteran
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         CTA
    ========================= -->

    <section class="cta">

        <div class="container">

            <h2>
                ARE YOU READY TO <span class="text-danger">
                SURVIVE?
                </span>
            </h2>

            <p class="lead">
                The nightmare has only just begun.
            </p>

            <a href="#games" class="btn btn-danger mt-3">
                ENTER THE NIGHTMARE
            </a>

        </div>

    </section>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer>

        <div class="container">

            <p class="mb-0">
                RESIDENT <span>EVIL</span> — SURVIVAL HORROR EXPERIENCE
            </p>

            <small>
                Fan-made educational website
            </small>

        </div>

    </footer>


    <!-- Bootstrap JS -->

    <script 
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>